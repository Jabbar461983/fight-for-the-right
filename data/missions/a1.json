{
  "id": "a1",
  "faction": "aero",
  "order": 1,
  "map": "kristalltal",
  "titleKey": "mission.a1.title",
  "briefingKey": "mission.a1.briefing",
  "briefingGoals": ["mission.a1.goal.base", "mission.a1.goal.army", "mission.a1.goal.outpost"],
  "players": [
    { "id": 1, "faction": "aero", "color": 0, "team": 1, "nameKey": "mission.player.aero" },
    { "id": 2, "faction": "granite", "color": 1, "team": 2, "nameKey": "mission.player.granite" }
  ],
  "credits": { "easy": 6000, "medium": 4500, "hard": 3500 },
  "locked": ["airfield", "shipyard", "techCenter", "flakPosition", "rocketBattery", "bunker", "repairStation"],
  "areas": {
    "playerBase": [5, 48, 12, 12],
    "outpost": [46, 3, 14, 14],
    "outpostGate": [48, 15, 6, 4]
  },
  "events": [
    {
      "when": [{ "type": "start" }],
      "do": [
        { "type": "spawn", "owner": 1, "unit": "constructionWagon", "at": "playerBase" },
        { "type": "spawn", "owner": 1, "unit": "lightTank", "at": "playerBase" },
        { "type": "spawn", "owner": 1, "unit": "rifleman", "count": 2, "at": "playerBase" },
        { "type": "base", "owner": 2, "at": [53, 10], "buildings": ["powerPlant", "barracks", "mgTower", "mgTower"], "tag": "outpost" },
        { "type": "building", "owner": 2, "building": "cannonTower", "at": [50, 15], "tag": "outpost", "difficulty": ["medium", "hard"] },
        { "type": "building", "owner": 2, "building": "mgTower", "at": [55, 16], "tag": "outpost", "difficulty": ["hard"] },
        { "type": "spawn", "owner": 2, "unit": "rifleman", "count": { "easy": 3, "medium": 4, "hard": 6 }, "at": "outpost", "tag": "guards" },
        { "type": "spawn", "owner": 2, "unit": "lightTank", "count": { "easy": 0, "medium": 1, "hard": 2 }, "at": "outpostGate", "tag": "guards" },
        { "type": "message", "key": "mission.a1.m.welcome" },
        { "type": "objective", "id": "deploy", "key": "mission.a1.o.deploy" }
      ]
    },
    {
      "when": [{ "type": "built", "owner": 1, "building": "constructionYard" }],
      "do": [
        { "type": "complete", "id": "deploy" },
        { "type": "message", "key": "mission.a1.m.power" },
        { "type": "objective", "id": "power", "key": "mission.a1.o.power" }
      ]
    },
    {
      "when": [{ "type": "objectivesDone", "ids": ["deploy"] }, { "type": "built", "owner": 1, "building": "powerPlant" }],
      "do": [
        { "type": "complete", "id": "power" },
        { "type": "message", "key": "mission.a1.m.refinery" },
        { "type": "objective", "id": "refinery", "key": "mission.a1.o.refinery" }
      ]
    },
    {
      "when": [{ "type": "objectivesDone", "ids": ["power"] }, { "type": "built", "owner": 1, "building": "refinery" }],
      "do": [
        { "type": "complete", "id": "refinery" },
        { "type": "message", "key": "mission.a1.m.barracks" },
        { "type": "objective", "id": "barracks", "key": "mission.a1.o.barracks" }
      ]
    },
    {
      "when": [{ "type": "objectivesDone", "ids": ["refinery"] }, { "type": "built", "owner": 1, "building": "barracks" }],
      "do": [
        { "type": "complete", "id": "barracks" },
        { "type": "message", "key": "mission.a1.m.factory" },
        { "type": "objective", "id": "factory", "key": "mission.a1.o.factory" }
      ]
    },
    {
      "when": [{ "type": "objectivesDone", "ids": ["barracks"] }, { "type": "built", "owner": 1, "building": "factory" }],
      "do": [
        { "type": "complete", "id": "factory" },
        { "type": "message", "key": "mission.a1.m.army" },
        { "type": "objective", "id": "army", "key": "mission.a1.o.army" }
      ]
    },
    {
      "when": [{ "type": "objectivesDone", "ids": ["factory"] }, { "type": "army", "owner": 1, "atLeast": 8 }],
      "do": [
        { "type": "complete", "id": "army" },
        { "type": "reveal", "area": "outpost" },
        { "type": "message", "key": "mission.a1.m.attack" },
        { "type": "objective", "id": "outpost", "key": "mission.a1.o.outpost" }
      ]
    },
    {
      "when": [{ "type": "time", "seconds": 45 }],
      "do": [{ "type": "message", "key": "mission.a1.m.controls" }]
    },
    {
      "difficulty": ["medium", "hard"],
      "when": [{ "type": "time", "seconds": { "easy": 9999, "medium": 480, "hard": 360 } }],
      "do": [
        { "type": "message", "key": "mission.a1.m.raid" },
        { "type": "spawn", "owner": 2, "unit": "rifleman", "count": { "easy": 0, "medium": 3, "hard": 4 }, "at": "outpostGate", "attackTo": "playerBase" },
        { "type": "spawn", "owner": 2, "unit": "lightTank", "count": 1, "at": "outpostGate", "attackTo": "playerBase", "difficulty": ["hard"] }
      ]
    },
    {
      "difficulty": ["hard"],
      "when": [{ "type": "time", "seconds": 660 }],
      "do": [
        { "type": "message", "key": "mission.a1.m.raid" },
        { "type": "spawn", "owner": 2, "unit": "rifleman", "count": 4, "at": "outpostGate", "attackTo": "playerBase" },
        { "type": "spawn", "owner": 2, "unit": "lightTank", "count": 2, "at": "outpostGate", "attackTo": "playerBase" }
      ]
    },
    {
      "when": [{ "type": "destroyed", "tag": "outpost" }],
      "do": [
        { "type": "complete", "id": "outpost" },
        { "type": "message", "key": "mission.a1.m.won" },
        { "type": "victory" }
      ]
    },
    {
      "when": [{ "type": "noBase", "owner": 1 }],
      "do": [{ "type": "defeat", "key": "mission.lost.base" }]
    }
  ]
}
